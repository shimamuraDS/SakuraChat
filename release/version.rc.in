#include <windows.h>
1 VERSIONINFO
FILEVERSION @SAKURA_VERSION_TUPLE@,0
PRODUCTVERSION @SAKURA_VERSION_TUPLE@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "SakuraChat"
      VALUE "FileVersion", "@SAKURA_RELEASE_VERSION@"
      VALUE "ProductName", "SakuraChat"
      VALUE "ProductVersion", "@SAKURA_RELEASE_VERSION@"
      VALUE "OriginalFilename", "appSakuraChat.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
